# Opendev API 配置（复制本文件为 .env，按你的 API 文档填写）

# 1. 必填：API 密钥与接口地址
OPENDEV_API_KEY=your_api_key_here
OPENDEV_BASE_URL=https://api.opendev.ai/v1

# 2. 必填:模型名称（以下仅为示例，实际取值请参考 Opendev 模型文档）
ASR_MODEL=whisper-1          # 语音识别模型
CHAT_MODEL=gpt-4o-mini       # 对话生成模型（用于非意图指令的聊天）
TTS_MODEL=tts-1              # 语音合成模型
TTS_VOICE=alloy              # 合成音色（alloy / echo / nova ...）

# 3. 可选：唤醒词（多个用逗号分隔，留空表示关闭唤醒词门控）
WAKE_WORDS=小夜,晓夜,小也

# 4. 可选：唤醒后连续对话窗口秒数（默认 20）
FOLLOW_UP_SECONDS=20

# 5. 可选：HTTP 监听端口（默认 8787）
PORT=8787
