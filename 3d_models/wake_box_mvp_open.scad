// =============================================================================
// Wake 睡眠环境守夜盒 · MVP 极速单件敞口收纳斗 (Open-Top Prototype Caddy)
// 设计者: 刘航成 & 夏工 & Antigravity
// 特点: 
//   1. 单件一体成型，无顶盖、零装配公差，拓竹打印 100% 成功。
//   2. 前低后高斜切口：前壁低矮不挡屏、不硌手，后壁支撑开发板。
//   3. 面包板与杜邦线直接插在敞口内，现场秒级排障免拆螺丝。
//   4. 四周侧壁各放一个传感器：前PIR、后灯环、左温感、右光敏。
// =============================================================================

$fn = 60;

// 外轮廓尺寸 (适配常见 400孔长面包板或 170孔小面包板)
box_w = 114;      // 宽度
box_d = 96;       // 深度
h_front = 24;     // 前壁高度 (低矮不挡视线)
h_rear = 58;      // 后壁高度 (支撑开发板与灯环)
wall = 2.2;       // 壁厚 (拓竹 0.4 喷嘴恰好 5 道整墙，极结实)

// 传感器开孔参数
pir_d = 12.5;     // AM412 PIR 探头直径
bh1750_d = 5.0;   // BH1750 光敏采光孔
ws2812_ring_od = 32.5; // WS2812 8位灯环外径
ws2812_ring_id = 17.5; // WS2812 内圈透光孔

open_mvp_caddy();

module open_mvp_caddy() {
    difference() {
        // 1. 外轮廓放样斜口体 (前低后高)
        polyhedron(
            points = [
                // 底面 4 点 (z=0)
                [0, 0, 0],          // 0: 前左底
                [box_w, 0, 0],      // 1: 前右底
                [box_w, box_d, 0],  // 2: 后右底
                [0, box_d, 0],      // 3: 后左底
                // 顶沿 4 点 (前高 24, 后高 58)
                [0, 0, h_front],          // 4: 前左顶
                [box_w, 0, h_front],      // 5: 前右顶
                [box_w, box_d, h_rear],   // 6: 后右顶
                [0, box_d, h_rear]        // 7: 后左顶
            ],
            faces = [
                [0, 1, 2, 3],       // 底
                [0, 4, 5, 1],       // 前壁
                [1, 5, 6, 2],       // 右壁 (斜边)
                [2, 6, 7, 3],       // 后壁 (高壁)
                [3, 7, 4, 0]        // 左壁 (斜边)
                // 顶口开放，无顶盖！
            ]
        );

        // 2. 内部彻底掏空 (留下 wall 壁厚，形成敞口大内胆)
        translate([wall, wall, wall])
            polyhedron(
                points = [
                    [0, 0, 0],
                    [box_w - 2*wall, 0, 0],
                    [box_w - 2*wall, box_d - 2*wall, 0],
                    [0, box_d - 2*wall, 0],
                    [0, 0, h_front],
                    [box_w - 2*wall, 0, h_front],
                    [box_w - 2*wall, box_d - 2*wall, h_rear],
                    [0, box_d - 2*wall, h_rear]
                ],
                faces = [
                    [0, 1, 2, 3],
                    [0, 4, 5, 1],
                    [1, 5, 6, 2],
                    [2, 6, 7, 3],
                    [3, 7, 4, 0]
                ]
            );

        // 3. 【正前壁开孔】AM412 PIR 人体红外圆球视窗 (居中或偏右)
        translate([box_w / 2, -0.1, h_front / 2 + 2])
            rotate([-90, 0, 0])
                cylinder(d = pir_d, h = wall + 0.2);

        // 4. 【后背高壁开孔】WS2812 8位灯环沉孔 (朝后墙打柔和漫反射环境光)
        translate([box_w / 2, box_d - wall - 0.1, h_rear - 24])
            rotate([-90, 0, 0])
                cylinder(d = ws2812_ring_od, h = wall + 0.2);

        // 5. 【后背出线槽】Type-C 供电/烧录线插口
        translate([20, box_d - wall - 0.1, wall + 2])
            cube([14, wall + 0.2, 8]);

        // 6. 【左侧壁百叶窗】SPA06 气压温度对流通风百叶
        for (i = [0:4]) {
            translate([-0.1, 25 + i*8, wall + 3])
                cube([wall + 0.2, 4.5, 9]);
        }

        // 7. 【右侧壁开孔】BH1750 环境光敏采光孔
        translate([box_w - wall - 0.1, 40, h_front + 8])
            rotate([0, 90, 0])
                cylinder(d = bh1750_d, h = wall + 0.2);
    }

    // 8. 内部开发板倾斜倚靠卡槽 (让 ESP32-S3 屏幕斜靠在后方，面向敞口)
    translate([box_w / 2 - 35, 48, wall])
        cube([70, 3, 6]); // 底部防滑挡条
}
